# Deny the build context by default. Only the runtime allowlist below is sent
# to the Docker daemon, so ignored local files cannot be baked into an image.
**

!Dockerfile
!Dockerfile.diart
!requirements.txt
!requirements-transcription.txt
!constraints-py312.txt
!requirements-diarization.txt
!requirements-diart.txt
!constraints-diart-py310-linux.txt
!config.docker.yaml

!src/
!src/**/*.py

!scripts/
!scripts/**/*.py

!configs/
!configs/**/*.yaml
!configs/**/*.yml
!configs/**/*.json
!configs/**/*.md

# Machine-local corpus overlays remain private even under the allowed configs tree.
configs/asu_june_bot/*.local.yaml
configs/asu_june_bot/*.local.yml

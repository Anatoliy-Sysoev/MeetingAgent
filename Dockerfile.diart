FROM ubuntu:22.04

ARG APP_UID=10001
ARG APP_GID=10001

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV HF_HOME=/cache/huggingface
ENV MPLCONFIGDIR=/cache/matplotlib

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        libportaudio2 \
        libsndfile1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${APP_GID}" meetingagent \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home \
        --shell /usr/sbin/nologin meetingagent

COPY requirements-diart.txt /app/requirements-diart.txt
COPY constraints-diart-py310-linux.txt /app/constraints-diart-py310-linux.txt
RUN python3 -m pip install --upgrade "pip==26.1.1" \
    && python3 -m pip install \
        -c /app/constraints-diart-py310-linux.txt \
        -r /app/requirements-diart.txt \
    && python3 -m pip check

COPY scripts/50_diart_preflight.py /app/scripts/50_diart_preflight.py

RUN install -d -o meetingagent -g meetingagent /cache /input /output

USER meetingagent:meetingagent

ENTRYPOINT ["python3", "scripts/50_diart_preflight.py"]
CMD ["--json"]

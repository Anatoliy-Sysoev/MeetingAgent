# Скопируй в .env только если будущему сервису понадобятся переменные окружения.
# .env нельзя коммитить.
# Не коммить реальные токены, пароли и локальные секреты.

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# Controls startup safety validation.
#   local       — local development defaults; weak config produces warnings only.
#   self_hosted — LAN/internet exposure; missing/weak required settings abort startup.
# Default: local
# MEETINGAGENT_DEPLOYMENT_MODE=local

# ---------------------------------------------------------------------------
# API Authentication
# ---------------------------------------------------------------------------
# Required. Bearer token for machine/script access to the MeetingAgent API.
# Generate a strong random value (min 32 chars) and keep it in .env only.
# Any platform: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Linux/macOS:  openssl rand -hex 32
# Self-hosted:  REQUIRED — startup fails if missing, placeholder, or < 32 chars.
MEETINGAGENT_API_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Bootstrap safety for self-hosted / non-local deployments.
# By default, POST /admin/bootstrap is only accessible from localhost (127.0.0.1 / ::1).
# To allow bootstrap from a non-local address (e.g. LAN, Docker, reverse proxy), set:
#   MEETINGAGENT_BOOTSTRAP_ALLOW_REMOTE=true
#   MEETINGAGENT_BOOTSTRAP_SECRET=<strong-random-value>
# Then send the secret in the X-Bootstrap-Token header of the bootstrap request.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Remove or unset both variables after the first admin is created.
# MEETINGAGENT_BOOTSTRAP_ALLOW_REMOTE=false
# MEETINGAGENT_BOOTSTRAP_SECRET=CHANGE_THIS_BEFORE_ENABLING_REMOTE_BOOTSTRAP

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1

MEETING_AGENT_WORK_ROOT=%USERPROFILE%/Desktop/AI/MeetingAgent
MEETING_AGENT_PROJECT_ROOT=%USERPROFILE%/Desktop/PROJECT_DOCUMENTS
MEETING_AGENT_CONFIG_PATH=config.yaml

MEETING_AGENT_EMBEDDING_MODEL=bge-m3
MEETING_AGENT_CHAT_MODEL=qwen3.5:4b
MEETING_AGENT_EMBEDDING_NUM_CTX=8192

# Project Knowledge Bot corpus feature flag.
# Keep private corpus packages under ignored data/ paths.
ASU_JUNE_BOT_ACTIVE_CORPUS=default

# Project Knowledge Bot / Telegram adapter
ASU_JUNE_BOT_TELEGRAM_TOKEN=PASTE_TOKEN_HERE
ASU_JUNE_BOT_CHAT_API_URL=http://127.0.0.1:8000/chat
ASU_JUNE_BOT_ALLOWED_CHAT_IDS=123456789
ASU_JUNE_BOT_TELEGRAM_TOP_K=5
ASU_JUNE_BOT_TELEGRAM_MODEL=qwen3.5:4b
ASU_JUNE_BOT_TELEGRAM_MAX_TOKENS=700
ASU_JUNE_BOT_TELEGRAM_TIMEOUT_SEC=300

# Docker
MEETINGAGENT_API_PORT=8000

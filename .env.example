# Скопируй в .env только если будущему сервису понадобятся переменные окружения.
# .env нельзя коммитить.
# Не коммить реальные токены, пароли и локальные секреты.

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# Controls startup safety validation.
#   local       — local development defaults; weak config produces warnings only.
#   self_hosted — LAN/internet exposure; missing/weak required settings abort startup.
# Default: local
# MEETINGAGENT_DEPLOYMENT_MODE=local

# ---------------------------------------------------------------------------
# API Authentication
# ---------------------------------------------------------------------------
# Required. Bearer token for machine/script access to the MeetingAgent API.
# Minimum length: 32 characters.
# Must NOT be a repeated pattern (e.g. "aaa..."), a repeated short block
# (e.g. "abcabc..."), or a known placeholder word.
# Minimum length is not sufficient — secrets must be unpredictable.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Linux/macOS: openssl rand -hex 32
# Self-hosted: REQUIRED — startup fails if missing, placeholder, short, or low-entropy.
MEETINGAGENT_API_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Bootstrap safety for self-hosted / non-local deployments.
# By default, POST /admin/bootstrap requires both a loopback peer and a
# localhost/loopback Host header. Foreign Host headers never get local bypass.
# To allow bootstrap from a non-local address (e.g. LAN, Docker, reverse proxy), set:
#   MEETINGAGENT_BOOTSTRAP_ALLOW_REMOTE=true
#   MEETINGAGENT_BOOTSTRAP_SECRET=<strong-random-value>
# Then send the secret in the X-Bootstrap-Token header of the bootstrap request.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The secret must not be a placeholder, repeated pattern, or shorter than 32 characters.
# Remove or unset both variables after the first admin is created.
# MEETINGAGENT_BOOTSTRAP_ALLOW_REMOTE=false
# MEETINGAGENT_BOOTSTRAP_SECRET=CHANGE_THIS_BEFORE_ENABLING_REMOTE_BOOTSTRAP

# ---------------------------------------------------------------------------
# Future browser OAuth/OIDC providers
# ---------------------------------------------------------------------------
# Local login is the current implemented browser auth path.
# Yandex ID is the first planned external provider; keep values local only.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=http://127.0.0.1:8000/auth/yandex/callback
# MEETINGAGENT_ALLOWED_EMAILS=
# MEETINGAGENT_EDITOR_EMAILS=
# MEETINGAGENT_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Trusted reverse proxy (for cookie_secure=auto with HTTPS)
# ---------------------------------------------------------------------------
# auth.cookie_secure=auto trusts X-Forwarded-Proto: https ONLY from trusted proxies.
# X-Forwarded-Proto from untrusted clients is always ignored to prevent spoofing.
# Configure the CIDR ranges of your reverse proxy here (comma-separated).
# Self-hosted with HTTPS reverse proxy: set this to the proxy's address range.
# Example: MEETINGAGENT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
# If not set, auth.cookie_secure=auto resolves as False unless TLS terminates at Uvicorn.
# Alternative: set auth.cookie_secure=true to always enable Secure cookies regardless.
# MEETINGAGENT_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# ---------------------------------------------------------------------------
# Optional Diart real-time diarization pilot
# ---------------------------------------------------------------------------
# Required only for downloading gated pyannote models in the isolated Diart
# container. Accept the model conditions first and keep this token local.
# HF_TOKEN=
# MEETINGAGENT_DIART_INPUT_DIR=./watched_folder

# Host header allowlist for self-hosted/reverse-proxy deployment.
# Localhost/loopback defaults are always accepted. Add the public/internal DNS
# name here before exposing the API. Do not use "*" and do not include ports.
# MEETINGAGENT_ALLOWED_HOSTS=meeting.example.internal

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1

MEETING_AGENT_WORK_ROOT=%USERPROFILE%/Desktop/AI/MeetingAgent
MEETING_AGENT_PROJECT_ROOT=%USERPROFILE%/Desktop/PROJECT_DOCUMENTS
MEETING_AGENT_CONFIG_PATH=config.yaml

# Optional isolated Python workers for heavy offline stages. Keep machine paths
# local; unset variables preserve the single-environment API interpreter.
# Live MIC/SYS capture intentionally remains inside the API live environment.
# MEETINGAGENT_LIVE_PYTHON=C:\ma-live\Scripts\python.exe
# MEETINGAGENT_LIVE_MODEL_PATH=C:\ma-models\vosk-model-small-ru-0.22
# MEETINGAGENT_WORKER_PYTHON=C:\ma-live\Scripts\python.exe
# MEETINGAGENT_TRANSCRIPTION_PYTHON=C:\ma-asr\Scripts\python.exe
# MEETINGAGENT_GIGAAM_PYTHON=C:\ma-gigaam\Scripts\python.exe
# MEETINGAGENT_DIARIZATION_PYTHON=C:\ma-diarization\Scripts\python.exe
# MEETINGAGENT_DIARIZATION_MODELS_DIR=C:\ma-models\diarization

MEETING_AGENT_EMBEDDING_MODEL=bge-m3
MEETING_AGENT_CHAT_MODEL=qwen3.5:4b
MEETING_AGENT_EMBEDDING_NUM_CTX=8192

# Project Knowledge Bot corpus feature flag.
# Keep private corpus packages under ignored data/ paths.
ASU_JUNE_BOT_ACTIVE_CORPUS=default

# Project Knowledge Bot / Telegram adapter
ASU_JUNE_BOT_TELEGRAM_TOKEN=PASTE_TOKEN_HERE
ASU_JUNE_BOT_CHAT_API_URL=http://127.0.0.1:8000/chat
# Fail-closed by default: configure one or more IDs.
ASU_JUNE_BOT_ALLOWED_CHAT_IDS=123456789
# Unsafe opt-in for development only. Keep false for normal use.
ASU_JUNE_BOT_ALLOW_ALL_CHAT_IDS=false
ASU_JUNE_BOT_TELEGRAM_TOP_K=5
ASU_JUNE_BOT_TELEGRAM_MODEL=qwen3.5:4b
ASU_JUNE_BOT_TELEGRAM_MAX_TOKENS=700
ASU_JUNE_BOT_TELEGRAM_TIMEOUT_SEC=300

# Docker
# Local-only by default. Changing this to 0.0.0.0 or a LAN address requires
# MEETINGAGENT_DEPLOYMENT_MODE=self_hosted plus a strong API token, explicit
# MEETINGAGENT_ALLOWED_HOSTS and secure cookie/proxy settings.
MEETINGAGENT_BIND_HOST=127.0.0.1
MEETINGAGENT_API_PORT=8000

# Local packaging preflight defaults.
# Override only when Ollama is exposed on a non-default host/port.
# scripts/42_local_preflight.py defaults:
#   --ollama-url http://localhost:11434
#   --embedding-model bge-m3
#   --chat-model qwen3.5:4b
